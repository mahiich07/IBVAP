# ==============================================================================
# IBVAP Environment Configuration Variables
# Copy to .env: cp .env.example .env
# ==============================================================================

# Node Identity & Deployment Role
IBVAP_NODE_ID=BOP-ALPHA-EDGE-01
IBVAP_DEFAULT_BOP="BOP Alpha"
IBVAP_ENV=production

# Server Binding
IBVAP_HOST=0.0.0.0
IBVAP_PORT=8000

# Security Keys & JWT Secrets (Change for production military networks)
IBVAP_SECRET_KEY=b0rd3r-d3f3ns3-s1h-2026-s3cur3-k3y-m1l1t4ry-gr4d3
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Storage Path (Mounted into persistent docker volume)
DATABASE_PATH=/app/data/ibvap.db

# Edge Hardware Acceleration
ENABLE_JETSON_HW_ACCEL=true
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# Upstream Battalion HQ Endpoint (For edge synchronization protocol)
BATTALION_HQ_URL=https://battalion-hq.defense.mil:8443/api/v1/sync/ingest
BATTALION_SYNC_INTERVAL_SEC=30
