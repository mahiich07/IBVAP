# ==============================================================================
# IBVAP Edge Computer Vision Inference Worker Container
# Supports NVIDIA Jetson (L4T / CUDA) and Edge Linux Nodes
# ==============================================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATABASE_PATH=/app/data/ibvap.db \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

WORKDIR /app

# Install GStreamer, OpenCV runtime dependencies, and hardware acceleration libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN mkdir -p /app/data && \
    useradd -m -u 1000 ibvapuser && \
    chown -R ibvapuser:ibvapuser /app

USER ibvapuser

VOLUME ["/app/data"]

CMD ["python", "edge_worker.py", "--cameras", "CAM-07", "CAM-04", "CAM-08"]
